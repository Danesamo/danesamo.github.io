---
import { profile } from "../data/site";

const links = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/projects/", label: "Projects" },
  { href: "/experience/", label: "Experience" },
  { href: "/contact/", label: "Contact" },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-line-dark bg-navy">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 font-display text-[1.05rem] font-semibold text-ivory no-underline">
      <span class="grid h-9 w-9 place-items-center rounded-[10px] bg-terracotta text-[0.9rem] font-bold text-navy" aria-hidden="true">DS</span>
      {profile.name}
    </a>

    <button
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-menu"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-line-dark-2 text-ivory md:hidden"
    >
      <span class="sr-only">Menu</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-7">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? "page" : undefined}
              class={`relative py-2 text-[0.97rem] font-medium no-underline transition-colors ${
                isActive(l.href)
                  ? "text-ivory after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:rounded after:bg-terracotta after:content-['']"
                  : "text-muted-light hover:text-ivory"
              }`}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <nav id="nav-menu" data-nav-menu aria-label="Main mobile" class="hidden border-t border-line-dark md:hidden">
    <ul class="container-site grid py-2">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={isActive(l.href) ? "page" : undefined}
            class={`flex min-h-12 items-center text-[1.02rem] font-medium no-underline ${isActive(l.href) ? "text-terracotta" : "text-ivory"}`}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
