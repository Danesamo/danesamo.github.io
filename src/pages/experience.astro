---
import Base from "../layouts/Base.astro";
import { experience, education, certifications } from "../data/site";
---

<Base title="Experience" description="Experience, education and certifications of Daniela Samo, Data & AI Engineer.">
  <section class="border-b border-line bg-ivory-2 py-14 sm:py-16">
    <div class="container-site">
      <p class="eyebrow">Experience</p>
      <h1 class="page-title">Where I have worked and studied</h1>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="container-site grid gap-14 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
      <div>
        <h2 class="section-title mb-8">Experience</h2>
        <ol class="grid gap-5">
          {experience.map((e) => (
            <li class="rounded-2xl border border-line bg-paper p-6 sm:p-7" data-reveal>
              <p class="font-mono text-[0.8rem] uppercase tracking-[0.08em] text-gold-deep">{e.time}</p>
              <h3 class="mt-2 text-[1.2rem] font-semibold">{e.title}</h3>
              <p class="text-muted">{e.where}</p>
              <p class="mt-3">{e.text}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {e.stack.map((s) => <li class="chip">{s}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <h2 class="section-title mb-8">Education</h2>
        <ol class="grid gap-6 border-l-2 border-line" data-reveal>
          {education.map((e) => (
            <li class="relative pl-6 before:absolute before:-left-[7px] before:top-2 before:h-3 before:w-3 before:rounded-full before:border-2 before:border-terracotta before:bg-ivory before:content-['']">
              <p class="font-mono text-[0.8rem] text-gold-deep">{e.time}</p>
              <p class="mt-1 font-semibold text-navy-2">{e.title}</p>
              <p class="text-[0.95rem] text-muted">{e.where}</p>
            </li>
          ))}
        </ol>

        <h2 class="section-title mb-5 mt-14">Certifications</h2>
        <ul data-reveal>
          {certifications.map((c) => (
            <li class="border-b border-line py-3.5">
              <p class="font-medium text-navy-2">{c.name}</p>
              <p class="text-[0.9rem] text-muted">{c.issuer}</p>
            </li>
          ))}
        </ul>

        <h2 class="section-title mb-3 mt-14">Languages</h2>
        <p>Bilingual French and English.</p>
      </div>
    </div>
  </section>
</Base>
