---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { cases, also } from "../../data/site";
---

<Base title="Projects" description="Data platforms, LLM systems and explainable machine learning projects by Daniela Samo.">
  <section class="border-b border-line bg-ivory-2 py-14 sm:py-16">
    <div class="container-site">
      <p class="eyebrow">Projects</p>
      <h1 class="page-title">Selected work</h1>
      <p class="mt-4 max-w-[60ch] text-muted">Professional work is described without internal names or code. Personal projects link to their repositories.</p>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="container-site">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {cases.map((p) => <ProjectCard project={p} />)}
      </div>

      <div class="mt-14" data-reveal>
        <h2 class="section-title mb-6">Also</h2>
        <ul class="grid gap-4 md:grid-cols-2">
          {also.map((a) => (
            <li class="rounded-2xl border border-line bg-paper p-6">
              <p class="font-semibold text-navy-2">{a.title}</p>
              <p class="mt-1 text-muted">{a.text}</p>
              {a.link && <a href={a.link.href} target="_blank" rel="noopener" class="text-link mt-2 inline-block">{a.link.label} <span aria-hidden="true">&rarr;</span></a>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>
