---
import Base from "../../layouts/Base.astro";
import Pipeline from "../../components/Pipeline.astro";
import { cases } from "../../data/site";

export function getStaticPaths() {
  return cases.map((project, index) => ({ params: { slug: project.slug }, props: { project, index } }));
}

const { project: p, index } = Astro.props;
const prev = cases[index - 1];
const next = cases[index + 1];
---

<Base title={p.title} description={p.summary}>
  <section class="bg-navy py-14 text-ivory sm:py-20">
    <div class="container-text">
      <a href="/projects/" class="font-mono text-[0.85rem] text-muted-light no-underline hover:text-ivory"><span aria-hidden="true">&larr;</span> All projects</a>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <span class="rounded-md bg-terracotta/15 px-2.5 py-1 font-mono text-[0.74rem] uppercase tracking-[0.06em] text-terracotta">{p.tag}</span>
        <span class="text-[0.88rem] text-muted-light">{p.origin}</span>
      </div>
      <h1 class="mt-4 text-[2.1rem] font-semibold text-ivory sm:text-[2.7rem]">{p.title}</h1>
      <p class="mt-4 text-[1.12rem] text-muted-light">{p.summary}</p>
      <div class="mt-10 max-w-[560px]">
        <Pipeline stages={p.pipeline} dark />
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="container-text">
      <dl class="grid gap-10">
        {p.details.map((d) => (
          <div data-reveal>
            <dt class="eyebrow">{d.label}</dt>
            <dd class="m-0 text-[1.08rem]">{d.text}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-12 border-t border-line pt-8" data-reveal>
        <p class="eyebrow">Stack</p>
        <ul class="flex flex-wrap gap-2">
          {p.stack.map((s) => <li class="chip">{s}</li>)}
        </ul>
        {p.link && (
          <a href={p.link.href} target="_blank" rel="noopener" class="btn btn-outline mt-8">{p.link.label}</a>
        )}
      </div>

      <nav class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2" aria-label="Other projects">
        {prev ? (
          <a href={`/projects/${prev.slug}/`} class="group rounded-xl border border-line bg-paper p-5 no-underline hover:border-[#C9B99C]">
            <span class="font-mono text-[0.78rem] text-muted"><span aria-hidden="true">&larr;</span> Previous</span>
            <span class="mt-1 block font-semibold text-navy-2 group-hover:text-terracotta-deep">{prev.title}</span>
          </a>
        ) : <span></span>}
        {next && (
          <a href={`/projects/${next.slug}/`} class="group rounded-xl border border-line bg-paper p-5 text-right no-underline hover:border-[#C9B99C]">
            <span class="font-mono text-[0.78rem] text-muted">Next <span aria-hidden="true">&rarr;</span></span>
            <span class="mt-1 block font-semibold text-navy-2 group-hover:text-terracotta-deep">{next.title}</span>
          </a>
        )}
      </nav>
    </div>
  </section>
</Base>
